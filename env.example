# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Token Validation Configuration
ENABLE_STRICT_TOKEN_VALIDATION=true
ALLOW_UNKNOWN_TOKENS=false

# API Keys
TRON_API_KEY=your_tron_api_key_here

# Aggregator API Keys (optional - some features may be limited without them)
ZEROX_API_KEY=your_0x_api_key_here
PARASWAP_API_KEY=your_paraswap_api_key_here
COW_API_KEY=your_cow_api_key_here
SOCKET_API_KEY=your_socket_api_key_here
RANGO_API_KEY=your_rango_api_key_here
ROUTER_API_KEY=your_router_api_key_here

# Aggregator Configuration
ODOS_REFERRAL_CODE=0
RUBIC_FEE_WALLET=your_fee_wallet_address_here
SYMBIOSIS_ENABLED=true
SYMBIOSIS_PARTNER_ID=

# Price Impact Validation
PRICE_IMPACT_VALIDATION_ENABLED=true
PRICE_IMPACT_WARNING_THRESHOLD=1.0
PRICE_IMPACT_HIGH_THRESHOLD=3.0
PRICE_IMPACT_CRITICAL_THRESHOLD=5.0

# Gasless Transactions (EIP-7702 & Pimlico)
PIMLICO_API_KEY=your_pimlico_api_key_here
GASLESS_ENABLED=false
GASLESS_SUPPORTED_CHAINS=1,137,10,42161,56,8453

# Message Queue (Redis/Bull)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_ENABLED=false

# WebSocket Configuration
WEBSOCKET_PORT=3001
WEBSOCKET_ENABLED=false
WEBSOCKET_CORS_ORIGIN=*

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here_minimum_32_characters_recommended
WEBHOOK_RETRY_MAX=3
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_ENABLED=true

# Round-Trip Swap Configuration
ROUND_TRIP_MIN_CONFIRMATIONS_EVM=1
ROUND_TRIP_MIN_CONFIRMATIONS_SOLANA=1
ROUND_TRIP_MIN_CONFIRMATIONS_BITCOIN=3
ROUND_TRIP_DEFAULT_WAIT_SECONDS=30

# Logging
LOG_LEVEL=info

# AML Third Party
AML_PROVIDER_ENABLED=false
AML_PROVIDER_URL=provider-url
AML_PROVIDER_API_KEY=provider-api-key

# Encryption
ENCRYPTION_KEY=some_32_byte_long_secret_encryption_key
ENCRYPTION_SALT=some_16_byte_long_secret_signing_key

# MongoDB Configuration
# Main application database (used by Mongoose for AML, Swift, etc.)
MONGODB_URI=mongodb://localhost:27017/abot-microservices

# Error Logger MongoDB (optional - defaults to MONGODB_URI if not specified)
# Use separate database for error logging in production for better isolation
ERROR_LOGGER_MONGODB_URI=mongodb://localhost:27017/error-logs
ERROR_LOGGER_DB_NAME=error_logging_db
ERROR_LOGGER_COLLECTION_NAME=error_logs
